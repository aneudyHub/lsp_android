<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/menu_item_home">

    <fragment
        android:id="@+id/menu_item_home"
        android:name="com.system.lsp.ui.fragments.HomeFragment"
        android:label="@string/fragment_label_home" >
        <action
            android:id="@+id/action_menu_item_home_to_paymentsFragment"
            app:destination="@id/paymentsFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentsFragment"
        android:name="com.system.lsp.ui.fragments.PaymentsFragment"
        android:label="PaymentsFragment" >
        <argument
            android:name="loanId"
            app:argType="long" />
    </fragment>
</navigation>